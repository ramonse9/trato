{
  "name": "trato",
  "version": "0.1.0",
  "private": true,
  "description": "Aplicación privada para seguimiento comercial por proyecto.",
  "workspaces": [
    "apps/api",
    "apps/web"
  ],
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "packageManager": "npm@11.19.0",
  "overrides": {
    "@angular/build@22.2.3": {
      "vite": "8.3.5"
    },
    "vite": "8.3.5"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "verify": "npm run prisma:validate && npm run lint && npm test && npm run build",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspace @trato/api",
    "test:browser": "bash scripts/run-browser-tests.sh",
    "lint": "npm run lint --workspaces --if-present",
    "dev:api": "npm run start:dev --workspace @trato/api",
    "dev:web": "npm run start --workspace @trato/web",
    "start:api:prod": "npm run start:prod --workspace @trato/api",
    "db:up": "docker compose up -d postgres",
    "db:down": "docker compose down",
    "db:migrate": "npm run db:migrate --workspace @trato/api",
    "db:deploy": "npm run db:deploy --workspace @trato/api",
    "db:status": "npm exec --workspace @trato/api -- prisma migrate status",
    "db:backup": "bash scripts/backup-postgres.sh",
    "db:restore:check": "bash scripts/check-postgres-restore.sh",
    "db:seed": "npm run db:seed --workspace @trato/api",
    "user:create": "npm run user:create --workspace @trato/api",
    "prisma:generate": "npm run prisma:generate --workspace @trato/api",
    "prisma:validate": "npm run prisma:validate --workspace @trato/api",
    "ready:check": "npm run verify && npm run db:status && npm run readiness:check --workspace @trato/api"
  }
}
